---
/**
 * Custom SiteTitle — renders the default title/logo plus inline nav links.
 * Uses display:contents so the nav participates in the parent header's
 * flex layout without creating an extra wrapper.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro'
---

<div class="site-title-with-nav">
  <Default {...Astro.props}><slot /></Default>
  <nav class="header-nav-links" aria-label="Main navigation">
    <a href="/docs/introduction">Docs</a>
    <a href="/docs/quick-start">Quick Start</a>
    <a href="/docs/scenarios/overview">Scenarios</a>
    <a href="/docs/atoms/overview">Atoms</a>
    <a href="/docs/guides/cli">CLI</a>
  </nav>
</div>

<style>
  .site-title-with-nav {
    display: contents;
  }

  .header-nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: 1.25rem;
    font-family: var(--sl-font-system-mono);
    font-size: 0.75rem;
  }

  .header-nav-links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    padding: 0.3rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .header-nav-links a:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  @media (max-width: 50rem) {
    .header-nav-links {
      display: none;
    }
  }
</style>

<style is:global>
  /* Ensure the header's title area grows to push search/actions to the right */
  header.header .title-wrapper,
  header.header [data-sl-title] {
    flex-grow: 1 !important;
    display: flex !important;
    align-items: center !important;
  }
</style>
