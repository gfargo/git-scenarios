---
/**
 * Site title + inline nav rail.
 *
 * The default Starlight SiteTitle renders the logo + name as a link.
 * We render it untouched, then append our own nav rail using
 * `display: contents` so it joins the parent header's flex flow.
 *
 * Nav uses Bricolage Grotesque (display family) at a comfortable
 * size — distinct from the mono UI elsewhere on the page.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro'
---

<div class="site-title-with-nav">
  <Default {...Astro.props}><slot /></Default>
  <nav class="header-nav-links" aria-label="Primary navigation">
    <a href="/docs/quick-start">Quick&nbsp;start</a>
    <a href="/docs/scenarios/browse">Browse</a>
    <a href="/docs/atoms/overview">Atoms</a>
    <a href="/docs/architecture">Architecture</a>
    <a href="/docs/changelog">Changelog</a>
  </nav>
</div>

<style>
  .site-title-with-nav {
    display: contents;
  }

  .header-nav-links {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    margin-left: 1.75rem;
    /* Display-family font, sized to actually be readable. */
    font-family: var(--gs-display, system-ui);
    font-variation-settings: 'opsz' 14, 'wdth' 100, 'wght' 500;
    font-size: 0.92rem;
    letter-spacing: -0.005em;
  }

  .header-nav-links a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    padding: 0.45rem 0.75rem;
    white-space: nowrap;
    position: relative;
    transition: color 0.15s ease;
  }

  /* Tiny vertical separator between links — like callout list ticks */
  .header-nav-links a + a::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 14px;
    background: var(--gs-rule-strong, currentColor);
    opacity: 0.4;
    pointer-events: none;
  }

  .header-nav-links a:hover,
  .header-nav-links a:focus-visible {
    color: var(--gs-cyan, var(--sl-color-accent));
  }

  /* Cyan underline that scaleX-animates on hover */
  .header-nav-links a::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.32rem;
    height: 1.5px;
    background: var(--gs-cyan, var(--sl-color-accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .header-nav-links a:hover::after,
  .header-nav-links a:focus-visible::after {
    transform: scaleX(1);
  }

  @media (max-width: 60rem) {
    .header-nav-links {
      display: none;
    }
  }
</style>

<style is:global>
  /* Make the title area grow so search + actions stay right-aligned */
  header.header .title-wrapper,
  header.header [data-sl-title] {
    flex-grow: 1 !important;
    display: flex !important;
    align-items: center !important;
  }
</style>
