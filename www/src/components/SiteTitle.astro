---
/**
 * Custom SiteTitle — wraps Starlight's default title/logo lockup with
 * an inline nav rail. Uses `display: contents` so the nav joins the
 * parent header's flex flow without an extra wrapper.
 *
 * The "$" prompt prefix and "_" cursor on the title come from the
 * global custom.css so they hold up across both themes.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro'
---

<div class="site-title-with-nav">
  <Default {...Astro.props}><slot /></Default>
  <nav class="header-nav-links" aria-label="Primary navigation">
    <a href="/docs/quick-start">quick&nbsp;start</a>
    <a href="/docs/scenarios/browse">browse</a>
    <a href="/docs/atoms/overview">atoms</a>
    <a href="/docs/architecture">architecture</a>
    <a href="/docs/changelog">changelog</a>
  </nav>
</div>

<style>
  .site-title-with-nav {
    display: contents;
  }

  .header-nav-links {
    display: flex;
    align-items: center;
    gap: 0.05rem;
    margin-left: 2rem;
    font-family: var(--gs-mono, var(--sl-font-system-mono));
    font-size: 0.74rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .header-nav-links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    padding: 0.4rem 0.7rem;
    white-space: nowrap;
    position: relative;
    transition: color 0.15s ease;
  }

  /* Subtle dot separator between links — replaces background hover */
  .header-nav-links a + a::before {
    content: '·';
    position: absolute;
    left: -0.18rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gs-rule-strong, var(--sl-color-gray-5));
    pointer-events: none;
  }

  .header-nav-links a:hover,
  .header-nav-links a:focus-visible {
    color: var(--gs-emerald, var(--sl-color-accent));
  }

  /* Tiny emerald underline that animates in on hover */
  .header-nav-links a::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.18rem;
    height: 1px;
    background: var(--gs-emerald, var(--sl-color-accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .header-nav-links a:hover::after,
  .header-nav-links a:focus-visible::after {
    transform: scaleX(1);
  }

  @media (max-width: 60rem) {
    .header-nav-links {
      display: none;
    }
  }
</style>

<style is:global>
  /* Make the title area grow so search + actions stay right-aligned */
  header.header .title-wrapper,
  header.header [data-sl-title] {
    flex-grow: 1 !important;
    display: flex !important;
    align-items: center !important;
  }
</style>
