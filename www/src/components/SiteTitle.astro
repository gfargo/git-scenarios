---
/**
 * Custom SiteTitle override — renders the default site title/logo
 * followed by inline navigation links. Since SiteTitle sits inside
 * the header's flex row, the nav links appear on the same line,
 * to the left of the search bar.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro'
---

<Default {...Astro.props}><slot /></Default>
<nav class="header-nav-links" aria-label="Main navigation">
  <a href="/docs/introduction">Docs</a>
  <a href="/docs/quick-start">Quick Start</a>
  <a href="/docs/scenarios/overview">Scenarios</a>
  <a href="/docs/atoms/overview">Atoms</a>
  <a href="/docs/guides/cli">CLI</a>
</nav>

<style>
  .header-nav-links {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    margin-left: 1rem;
    font-family: var(--sl-font-system-mono);
    font-size: 0.75rem;
  }

  .header-nav-links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    padding: 0.35rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .header-nav-links a:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  @media (max-width: 50rem) {
    .header-nav-links {
      display: none;
    }
  }
</style>
