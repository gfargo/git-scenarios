---
/**
 * Interactive scenario browser — client-side filter UI over the
 * registry data emitted at build time by scripts/generate-scenarios-json.mjs.
 *
 * Filters: kind (radio-style), tag (multi-select chips), freeform text.
 * Combinator is AND across kind/tag filters, AND with text match.
 *
 * Renders:
 *   - Filter controls (kind selector, tag chips, search input)
 *   - Result count
 *   - Card grid of matching scenarios with name, summary, kind, tags, contracts
 *
 * Pure HTML + CSS + a single inline script — no framework runtime,
 * no client islands. The data is small (~46 scenarios → ~40KB JSON)
 * so we inline it as a JSON script tag and let the browser do the
 * filtering with vanilla JS.
 */
import scenarios from '../data/scenarios.json'

// Pre-compute available kinds + tags for the filter UI
const kinds = [...new Set(scenarios.map((s) => s.kind))].sort()
const allTags = [...new Set(scenarios.flatMap((s) => s.tags ?? []))].sort()

// Order kinds by the same convention used in the CLI (most-common first)
const KIND_ORDER = ['branch', 'worktree', 'operation', 'history', 'stash', 'submodule']
const orderedKinds = [
  ...KIND_ORDER.filter((k) => kinds.includes(k)),
  ...kinds.filter((k) => !KIND_ORDER.includes(k)),
]
---

<div class="scenario-browser">
  <div class="filters">
    <div class="filter-group">
      <label class="filter-label">Kind</label>
      <div class="filter-chips" data-filter-group="kind">
        <button class="chip chip-kind active" data-value="">All ({scenarios.length})</button>
        {orderedKinds.map((k) => (
          <button class="chip chip-kind" data-value={k}>
            {k} ({scenarios.filter((s) => s.kind === k).length})
          </button>
        ))}
      </div>
    </div>

    <div class="filter-group">
      <label class="filter-label">Tags</label>
      <div class="filter-chips" data-filter-group="tag">
        {allTags.map((t) => {
          const count = scenarios.filter((s) => (s.tags ?? []).includes(t)).length
          return (
            <button class="chip chip-tag" data-value={t}>
              {t} <span class="chip-count">{count}</span>
            </button>
          )
        })}
      </div>
    </div>

    <div class="filter-group">
      <label class="filter-label" for="scenario-search">Search</label>
      <input
        id="scenario-search"
        type="search"
        placeholder="Filter by name, summary, or contract…"
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <div class="filter-meta">
      <span class="result-count" data-result-count>{scenarios.length}</span> of {scenarios.length} scenarios
      <button class="reset-btn" data-reset hidden>Reset filters</button>
    </div>
  </div>

  <ul class="scenario-grid" data-scenario-grid>
    {scenarios.map((s) => (
      <li
        class="scenario-card"
        data-scenario
        data-kind={s.kind}
        data-tags={(s.tags ?? []).join(' ')}
        data-search={[s.name, s.summary, ...(s.contracts ?? [])].join(' ').toLowerCase()}
      >
        <div class="scenario-header">
          <a href={`/scenarios/${s.name}`} class="scenario-name-link" title={`View permalink for ${s.name}`}>
            <code class="scenario-name">{s.name}</code>
          </a>
          <span class={`scenario-kind kind-${s.kind}`}>{s.kind}</span>
        </div>
        <p class="scenario-summary">{s.summary}</p>
        {(s.tags ?? []).length > 0 && (
          <div class="scenario-tags">
            {(s.tags ?? []).map((t) => (
              <span class="scenario-tag" data-tag={t}>{t}</span>
            ))}
          </div>
        )}
        {(s.contracts ?? []).length > 0 && (
          <details class="scenario-contracts">
            <summary>{(s.contracts ?? []).length} contract{(s.contracts ?? []).length === 1 ? '' : 's'}</summary>
            <ul>
              {(s.contracts ?? []).map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </details>
        )}
        {(s.graph ?? []).length > 0 && (
          <details class="scenario-graph">
            <summary>commit graph · {(s.graph ?? []).length} line{(s.graph ?? []).length === 1 ? '' : 's'}</summary>
            <pre class="graph-pre"><code>{(s.graph ?? []).join('\n')}</code></pre>
          </details>
        )}
        <div class="scenario-actions">
          <button class="copy-btn" data-copy={`spinUpScenario('${s.name}')`} title="Copy spinUpScenario call">
            Copy spinUpScenario
          </button>
          <button class="copy-btn" data-copy={`npx git-scenarios create ${s.name}`} title="Copy CLI command">
            Copy CLI cmd
          </button>
        </div>
      </li>
    ))}
  </ul>

  <div class="empty-state" data-empty-state hidden>
    <p>No scenarios match the current filters.</p>
    <button class="reset-btn" data-reset>Reset filters</button>
  </div>
</div>

<style>
  .scenario-browser {
    --gap: 0.75rem;
    margin: 1.5rem 0 0;
    font-family: var(--gs-mono);
  }

  /* ─── Filters bar ─── */
  .filters {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--gs-rule);
    border-radius: 6px;
    background: var(--gs-surface);
    margin-bottom: 1.5rem;
    position: relative;
  }

  /* Editorial accent stripe on the left edge */
  .filters::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--gs-cyan);
    opacity: 0.5;
    border-radius: 6px 0 0 6px;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-label {
    font-family: var(--gs-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gs-cyan);
    font-weight: 500;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chip {
    appearance: none;
    border: 1px solid var(--gs-rule-strong);
    background: transparent;
    color: var(--sl-color-gray-2);
    font-family: var(--gs-mono);
    font-size: 0.74rem;
    font-weight: 400;
    padding: 0.3rem 0.65rem;
    border-radius: 2px;
    cursor: pointer;
    transition: color 0.14s ease, border-color 0.14s ease, background 0.14s ease, transform 0.12s ease, box-shadow 0.12s ease;
    line-height: 1.3;
  }

  .chip:hover {
    color: var(--gs-cyan);
    border-color: var(--gs-cyan);
  }

  .chip.active {
    background: var(--gs-cyan);
    color: var(--gs-paper);
    border-color: var(--gs-cyan);
    font-weight: 500;
  }

  .chip-tag {
    font-style: italic;
    font-variation-settings: normal;
  }

  .chip-tag::before {
    content: '#';
    margin-right: 0.1ch;
    opacity: 0.6;
  }

  .chip-count {
    opacity: 0.6;
    margin-left: 0.2rem;
    font-size: 0.65rem;
  }

  .chip.active .chip-count {
    opacity: 0.85;
  }

  #scenario-search {
    appearance: none;
    width: 100%;
    padding: 0.6rem 0.85rem 0.6rem 2.4rem;
    border: 1px solid var(--gs-rule-strong);
    border-radius: 2px;
    background: var(--gs-paper);
    color: var(--sl-color-white);
    font-family: var(--gs-mono);
    font-size: 0.85rem;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%2316a34a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='8'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg>");
    background-repeat: no-repeat;
    background-position: 0.85rem 50%;
  }

  #scenario-search:focus {
    outline: 1px solid var(--gs-cyan);
    outline-offset: 0;
    border-color: var(--gs-cyan);
  }

  .filter-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    font-family: var(--gs-mono);
    padding-top: 0.5rem;
    border-top: 1px dashed var(--gs-rule);
  }

  .filter-meta::before {
    content: '⤷';
    color: var(--gs-cyan);
    margin-right: 0.2rem;
  }

  .result-count {
    font-weight: 600;
    color: var(--gs-cyan);
    font-size: 0.85rem;
  }

  .reset-btn {
    appearance: none;
    background: transparent;
    border: none;
    color: var(--sl-color-gray-3);
    font-family: var(--gs-mono);
    font-size: 0.72rem;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    border-radius: 2px;
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-left: auto;
  }

  .reset-btn:hover {
    color: var(--gs-cyan);
  }

  /* ─── Card grid ─── */
  .scenario-grid {
    list-style: none !important;
    padding: 0 !important;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--gap);
  }

  .scenario-grid > li::before {
    content: none !important;        /* override the global +/· list bullets */
  }

  .scenario-card {
    border: 1px solid var(--gs-rule);
    border-radius: 4px;
    padding: 1rem 1.1rem;
    background: var(--gs-surface);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    list-style: none;
    padding-left: 1.1rem !important; /* override prose ul li */
    margin: 0 !important;
    position: relative;
  }

  /* Corner mark — appears on hover, like a torn page corner */
  .scenario-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 14px 14px 0 0;
    border-color: var(--gs-cyan) transparent transparent transparent;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .scenario-card:hover {
    border-color: var(--gs-cyan);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 0 var(--gs-rule-strong);
  }

  .scenario-card:hover::after {
    opacity: 0.95;
  }

  .scenario-card[hidden] {
    display: none;
  }

  .scenario-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .scenario-name-link {
    text-decoration: none;
    color: inherit;
  }

  .scenario-name-link:hover .scenario-name {
    color: var(--gs-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .scenario-name {
    font-family: var(--gs-mono);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--gs-ink);
    background: transparent;
    border: none;
    padding: 0;
  }

  .scenario-kind {
    font-family: var(--gs-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
    border: 1px solid currentColor;
    line-height: 1.4;
    background: transparent;
    flex-shrink: 0;
  }

  /* Each kind gets a distinct hue, all derived from the drafting
     palette so the page stays cohesive. Cyan is dominant; vermilion
     marks the destructive/in-progress kinds. */
  .kind-branch    { color: var(--gs-cyan);     }
  .kind-worktree  { color: var(--gs-cyan-dim); }
  .kind-operation { color: var(--gs-vermilion); }
  .kind-history   { color: var(--gs-amber);    }
  .kind-stash     { color: var(--gs-graphite); }
  .kind-submodule { color: var(--gs-graphite); }

  .scenario-summary {
    font-family: var(--gs-body);
    font-variation-settings: 'opsz' 12, 'SOFT' 50;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .scenario-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .scenario-tag {
    font-family: var(--gs-mono);
    font-size: 0.65rem;
    color: var(--sl-color-gray-3);
    padding: 0.1rem 0.4rem;
    border-radius: 2px;
    border: 1px solid var(--gs-rule);
    background: transparent;
    line-height: 1.4;
  }

  .scenario-tag::before {
    content: '#';
    opacity: 0.55;
    margin-right: 0.1ch;
  }

  .scenario-tag.active {
    color: var(--gs-cyan);
    border-color: var(--gs-cyan);
    background: var(--gs-cyan-low);
  }

  /* Contracts — like a small spec list */
  .scenario-contracts {
    font-family: var(--gs-mono);
    font-size: 0.78rem;
  }

  .scenario-contracts summary {
    cursor: pointer;
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    list-style: none;
    user-select: none;
  }

  .scenario-contracts summary::-webkit-details-marker {
    display: none;
  }

  .scenario-contracts summary::before {
    content: '▸';
    margin-right: 0.4rem;
    color: var(--gs-cyan);
    transition: transform 0.15s ease;
    display: inline-block;
  }

  .scenario-contracts[open] summary::before {
    transform: rotate(90deg);
  }

  .scenario-contracts summary:hover {
    color: var(--gs-cyan);
  }

  .scenario-contracts ul {
    margin: 0.5rem 0 0 0 !important;
    padding-left: 0 !important;
    color: var(--sl-color-gray-2);
    list-style: none;
  }

  .scenario-contracts ul li {
    margin: 0.2rem 0 !important;
    padding-left: 1.2rem !important;
    position: relative;
    font-family: var(--gs-mono);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .scenario-contracts ul li::before {
    content: '✓' !important;
    position: absolute;
    left: 0;
    top: 0;
    color: var(--gs-cyan) !important;
    font-size: 0.85em !important;
    opacity: 0.8;
  }

  /* Commit graph — the real `git log --graph` output, captured at build */
  .scenario-graph {
    font-family: var(--gs-mono);
    font-size: 0.78rem;
  }

  .scenario-graph summary {
    cursor: pointer;
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    list-style: none;
    user-select: none;
  }

  .scenario-graph summary::-webkit-details-marker {
    display: none;
  }

  .scenario-graph summary::before {
    content: '▸';
    margin-right: 0.4rem;
    color: var(--gs-amber);
    transition: transform 0.15s ease;
    display: inline-block;
  }

  .scenario-graph[open] summary::before {
    transform: rotate(90deg);
  }

  .scenario-graph summary:hover {
    color: var(--gs-amber);
  }

  .graph-pre {
    margin: 0.5rem 0 0 0 !important;
    padding: 0.7rem 0.8rem !important;
    background: var(--gs-paper) !important;
    border: 1px solid var(--gs-rule) !important;
    border-left: 2px solid var(--gs-amber) !important;
    border-radius: 2px;
    max-height: 16rem;
    overflow: auto;
    white-space: pre;
  }

  .graph-pre code {
    font-family: var(--gs-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--sl-color-gray-1);
    background: transparent;
    border: none;
    padding: 0;
    white-space: pre;
    tab-size: 2;
  }

  /* Action buttons */
  .scenario-actions {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .copy-btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--gs-rule);
    color: var(--sl-color-gray-3);
    font-family: var(--gs-mono);
    font-size: 0.68rem;
    padding: 0.3rem 0.55rem;
    border-radius: 2px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .copy-btn::before {
    content: '⌘';
    margin-right: 0.3rem;
    opacity: 0.7;
  }

  .copy-btn:hover {
    color: var(--gs-cyan);
    border-color: var(--gs-cyan);
    background: var(--gs-cyan-low);
  }

  .copy-btn.copied {
    color: var(--gs-paper);
    background: var(--gs-cyan);
    border-color: var(--gs-cyan);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--sl-color-gray-3);
    font-family: var(--gs-mono);
    font-size: 0.85rem;
    border: 1px dashed var(--gs-rule);
    border-radius: 6px;
  }

  .empty-state p {
    margin: 0 0 1rem 0;
  }

  .empty-state::before {
    content: 'no results';
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gs-cyan);
    margin-bottom: 1rem;
  }
</style>

<script>
  // ─── Filter logic ───
  // State: selected kind (string | ''), selected tags (Set<string>), search (string)
  // Read DOM, write data-state-driven visibility.

  const KIND_KEY = 'kind'
  const TAG_KEY = 'tag'

  const grid = document.querySelector<HTMLElement>('[data-scenario-grid]')
  const empty = document.querySelector<HTMLElement>('[data-empty-state]')
  const countEl = document.querySelector<HTMLElement>('[data-result-count]')
  const search = document.querySelector<HTMLInputElement>('#scenario-search')
  const resetBtns = document.querySelectorAll<HTMLButtonElement>('[data-reset]')

  if (!grid) {
    // Defensive — script runs only on the browser page where these exist.
    // eslint-disable-next-line no-console
    console.warn('[scenario-browser] grid element not found, skipping init')
  } else {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-scenario]'))
    const kindChips = document.querySelectorAll<HTMLButtonElement>('.chip-kind')
    const tagChips = document.querySelectorAll<HTMLButtonElement>('.chip-tag')

    const state = {
      kind: '',
      tags: new Set<string>(),
      query: '',
    }

    function applyFilters() {
      const q = state.query.trim().toLowerCase()
      let visible = 0
      for (const card of cards) {
        const cardKind = card.dataset.kind ?? ''
        const cardTags = (card.dataset.tags ?? '').split(' ').filter(Boolean)
        const cardSearch = card.dataset.search ?? ''

        const kindOk = !state.kind || cardKind === state.kind
        const tagsOk = state.tags.size === 0 || [...state.tags].every((t) => cardTags.includes(t))
        const searchOk = !q || cardSearch.includes(q)

        const show = kindOk && tagsOk && searchOk
        card.hidden = !show
        if (show) visible += 1

        // Reflect tag-active highlight on chips inside the card itself
        for (const chip of card.querySelectorAll<HTMLElement>('.scenario-tag')) {
          chip.classList.toggle('active', state.tags.has(chip.dataset.tag ?? ''))
        }
      }
      if (countEl) countEl.textContent = String(visible)
      if (empty) empty.hidden = visible !== 0
      if (grid) grid.hidden = visible === 0

      // Show reset button when any filter is active
      const isFiltered = !!state.kind || state.tags.size > 0 || !!q
      for (const btn of resetBtns) btn.hidden = !isFiltered
    }

    // Kind chip = mutually exclusive
    for (const chip of kindChips) {
      chip.addEventListener('click', () => {
        const value = chip.dataset.value ?? ''
        state.kind = value
        for (const c of kindChips) c.classList.toggle('active', c === chip)
        applyFilters()
      })
    }

    // Tag chips = multi-select
    for (const chip of tagChips) {
      chip.addEventListener('click', () => {
        const value = chip.dataset.value ?? ''
        if (state.tags.has(value)) {
          state.tags.delete(value)
          chip.classList.remove('active')
        } else {
          state.tags.add(value)
          chip.classList.add('active')
        }
        applyFilters()
      })
    }

    // Search debounce — small enough that a 60ms RAF-style throttle is fine
    let searchTimer: ReturnType<typeof setTimeout> | null = null
    if (search) {
      search.addEventListener('input', () => {
        if (searchTimer) clearTimeout(searchTimer)
        searchTimer = setTimeout(() => {
          state.query = search.value
          applyFilters()
        }, 60)
      })
    }

    // Reset
    for (const btn of resetBtns) {
      btn.addEventListener('click', () => {
        state.kind = ''
        state.tags.clear()
        state.query = ''
        for (const c of kindChips) c.classList.toggle('active', (c.dataset.value ?? '') === '')
        for (const c of tagChips) c.classList.remove('active')
        if (search) search.value = ''
        applyFilters()
      })
    }

    // ─── Copy buttons ───
    for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy-btn')) {
      btn.addEventListener('click', async () => {
        const payload = btn.dataset.copy ?? ''
        try {
          await navigator.clipboard.writeText(payload)
          const orig = btn.textContent
          btn.textContent = 'Copied!'
          btn.classList.add('copied')
          setTimeout(() => {
            btn.textContent = orig
            btn.classList.remove('copied')
          }, 1200)
        } catch {
          // Fall back to selection if clipboard API is unavailable.
          // eslint-disable-next-line no-console
          console.warn('[scenario-browser] clipboard.writeText failed')
        }
      })
    }

    // Reflect URL hash if present (e.g. #kind=operation&tag=conflict)
    const params = new URLSearchParams(location.hash.slice(1))
    const hashKind = params.get('kind')
    const hashTags = params.get('tag')?.split(',').filter(Boolean) ?? []
    if (hashKind) {
      state.kind = hashKind
      for (const c of kindChips) c.classList.toggle('active', (c.dataset.value ?? '') === hashKind)
    }
    if (hashTags.length) {
      for (const t of hashTags) state.tags.add(t)
      for (const c of tagChips) {
        if (state.tags.has(c.dataset.value ?? '')) c.classList.add('active')
      }
    }
    applyFilters()
  }
</script>
