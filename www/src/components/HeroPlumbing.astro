---
/**
 * Drafting-Room Hero — an engineering blueprint of git-scenarios.
 *
 * Three regions:
 *   1. Title block (top): drawing metadata + the headline lockup
 *   2. Drawing area (center): an animated SVG schematic of how
 *      git-scenarios composes — three layers (atoms → scenarios → API)
 *      with dimension lines and numbered callouts
 *   3. Specifications strip (bottom): by-the-numbers stats with
 *      dimension-line styling
 *
 * Pure HTML/SVG/CSS. The schematic animates on first paint via
 * stroke-dasharray + stroke-dashoffset.
 */
import { readFileSync } from 'fs';
import { resolve } from 'path';

// Read version from root package.json at build time
const rootPkg = JSON.parse(
  readFileSync(resolve(process.cwd(), '..', 'package.json'), 'utf-8')
);
const version = rootPkg.version;
---

<section class="dr-hero" aria-label="Introduction">
  <!-- Outer drawing border with corner crosshairs -->
  <div class="dr-frame">
    <span class="dr-corner dr-corner--tl" aria-hidden="true"></span>
    <span class="dr-corner dr-corner--tr" aria-hidden="true"></span>
    <span class="dr-corner dr-corner--bl" aria-hidden="true"></span>
    <span class="dr-corner dr-corner--br" aria-hidden="true"></span>

    <!-- ═══ Title block ═══
         An engineering title block. The project name belongs here as
         the drawing's PROJECT field — that IS the convention. The
         page <title> in <head> handles SEO; this h1 establishes the
         page identity visually. -->
    <header class="dr-titleblock">
      <div class="dr-titleblock__cell dr-titleblock__cell--title">
        <span class="dr-label">Project</span>
        <h1 class="dr-title">git&#8209;scenarios</h1>
      </div>
      <div class="dr-titleblock__cell">
        <span class="dr-label">Drawn by</span>
        <span class="dr-value">G. Fargo</span>
      </div>
      <div class="dr-titleblock__cell">
        <span class="dr-label">Date</span>
        <span class="dr-value">2026·05·27</span>
      </div>
      <div class="dr-titleblock__cell">
        <span class="dr-label">Sheet</span>
        <span class="dr-value">01 / 04</span>
      </div>
      <div class="dr-titleblock__cell">
        <span class="dr-label">Revision</span>
        <span class="dr-value dr-value--accent">G · v{version}</span>
      </div>
      <div class="dr-titleblock__cell dr-titleblock__cell--scale">
        <span class="dr-label">Scale</span>
        <span class="dr-value">N.T.S.</span>
      </div>
    </header>

    <!-- ═══ Drawing area ═══ -->
    <div class="dr-drawing">
      <!-- Left column: the actual headline lockup -->
      <div class="dr-headline">
        <p class="dr-eyebrow">A composable kit for git‑state fixtures.</p>
        <h2 class="dr-display">
          <span class="dr-display__line">Real git repos.</span>
          <span class="dr-display__line"><em>Any state.</em></span>
          <span class="dr-display__line">One line of code.</span>
        </h2>
        <p class="dr-lede">
          A typed atom library and CLI for spinning up deterministic
          git fixtures &mdash; merge conflicts, submodules, multiple
          remotes, in&#8209;progress operations, monorepos, orphan
          branches. For tests, demos, and tool development.
        </p>

        <div class="dr-actions">
          <a class="dr-action dr-action--primary" href="/docs/quick-start">
            Get started <span aria-hidden="true">→</span>
          </a>
          <a class="dr-action dr-action--ghost" href="https://github.com/gfargo/git-scenarios">
            View source <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="dr-install">
          <span class="dr-install__prompt">$</span>
          <code class="dr-install__cmd">npm i -D @gfargo/git-scenarios simple-git</code>
          <button class="dr-install__copy" data-copy="npm install --save-dev @gfargo/git-scenarios simple-git" aria-label="Copy install command">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="4" y="4" width="9" height="9" rx="1.5"/>
              <path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H11"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Right column: SVG schematic of the layer cake -->
      <figure class="dr-figure">
        <svg
          class="dr-schematic"
          viewBox="0 0 360 380"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Schematic showing how git-scenarios composes atoms into scenarios into the public API"
        >
          <defs>
            <!-- Arrowhead for pipe flow -->
            <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
              <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
            </marker>
            <!-- Tick mark for dimension lines -->
            <marker id="tick" viewBox="-3 -4 6 8" refX="0" refY="0" markerWidth="6" markerHeight="8" orient="auto">
              <line x1="0" y1="-4" x2="0" y2="4" stroke="currentColor" stroke-width="1.2" />
            </marker>
          </defs>

          <!-- Background grid (drawing area only) -->
          <g class="dr-schematic__grid" aria-hidden="true">
            <!-- vertical -->
            <line x1="20" y1="20" x2="20"  y2="360" />
            <line x1="60" y1="20" x2="60"  y2="360" />
            <line x1="100" y1="20" x2="100" y2="360" />
            <line x1="140" y1="20" x2="140" y2="360" />
            <line x1="180" y1="20" x2="180" y2="360" />
            <line x1="220" y1="20" x2="220" y2="360" />
            <line x1="260" y1="20" x2="260" y2="360" />
            <line x1="300" y1="20" x2="300" y2="360" />
            <line x1="340" y1="20" x2="340" y2="360" />
            <!-- horizontal -->
            <line x1="20" y1="60"  x2="340" y2="60" />
            <line x1="20" y1="100" x2="340" y2="100" />
            <line x1="20" y1="140" x2="340" y2="140" />
            <line x1="20" y1="180" x2="340" y2="180" />
            <line x1="20" y1="220" x2="340" y2="220" />
            <line x1="20" y1="260" x2="340" y2="260" />
            <line x1="20" y1="300" x2="340" y2="300" />
          </g>

          <!-- Layer 3: PUBLIC API (top) -->
          <g class="dr-schematic__layer" style="--d: 0.05s">
            <rect x="60" y="40" width="240" height="50" rx="2"
                  fill="var(--gs-paper)"
                  stroke="var(--gs-cyan)"
                  stroke-width="1.5"
                  class="dr-schematic__rect"/>
            <text x="180" y="63" text-anchor="middle"
                  class="dr-schematic__label-mono">spinUpScenario(name)</text>
            <text x="180" y="78" text-anchor="middle"
                  class="dr-schematic__label-small">PUBLIC API</text>
          </g>

          <!-- Pipe down from API to Scenarios -->
          <path
            class="dr-schematic__pipe"
            style="--d: 0.18s"
            d="M180 90 L180 130"
            fill="none"
            stroke="var(--gs-cyan)"
            stroke-width="1.5"
            marker-end="url(#arrow)"
          />

          <!-- Layer 2: SCENARIOS (middle) -->
          <g class="dr-schematic__layer" style="--d: 0.28s">
            <rect x="40" y="135" width="280" height="60" rx="2"
                  fill="var(--gs-paper)"
                  stroke="var(--gs-cyan)"
                  stroke-width="1.5"
                  class="dr-schematic__rect"/>
            <text x="180" y="158" text-anchor="middle"
                  class="dr-schematic__label-mono">32 named scenarios</text>
            <text x="180" y="175" text-anchor="middle"
                  class="dr-schematic__label-small">SCENARIO REGISTRY</text>
            <!-- Sub-divisions inside the scenario block -->
            <line x1="100" y1="135" x2="100" y2="195" stroke="var(--gs-rule-strong)" stroke-width="0.5" stroke-dasharray="2 3"/>
            <line x1="180" y1="135" x2="180" y2="195" stroke="var(--gs-rule-strong)" stroke-width="0.5" stroke-dasharray="2 3"/>
            <line x1="260" y1="135" x2="260" y2="195" stroke="var(--gs-rule-strong)" stroke-width="0.5" stroke-dasharray="2 3"/>
          </g>

          <!-- Three pipes branching down to atoms -->
          <path class="dr-schematic__pipe" style="--d: 0.42s"
                d="M100 195 L100 230" fill="none"
                stroke="var(--gs-cyan)" stroke-width="1.5" marker-end="url(#arrow)"/>
          <path class="dr-schematic__pipe" style="--d: 0.5s"
                d="M180 195 L180 230" fill="none"
                stroke="var(--gs-cyan)" stroke-width="1.5" marker-end="url(#arrow)"/>
          <path class="dr-schematic__pipe" style="--d: 0.58s"
                d="M260 195 L260 230" fill="none"
                stroke="var(--gs-cyan)" stroke-width="1.5" marker-end="url(#arrow)"/>

          <!-- Layer 1: ATOMS (bottom) — three columns -->
          <g class="dr-schematic__layer" style="--d: 0.72s">
            <rect x="60" y="235" width="80" height="50" rx="2"
                  fill="var(--gs-paper)" stroke="var(--gs-cyan)" stroke-width="1.5"
                  class="dr-schematic__rect"/>
            <text x="100" y="255" text-anchor="middle" class="dr-schematic__label-mono dr-schematic__label-mono--sm">addCommit</text>
            <text x="100" y="269" text-anchor="middle" class="dr-schematic__label-mono dr-schematic__label-mono--sm">chain</text>
          </g>
          <g class="dr-schematic__layer" style="--d: 0.78s">
            <rect x="140" y="235" width="80" height="50" rx="2"
                  fill="var(--gs-paper)" stroke="var(--gs-cyan)" stroke-width="1.5"
                  class="dr-schematic__rect"/>
            <text x="180" y="255" text-anchor="middle" class="dr-schematic__label-mono dr-schematic__label-mono--sm">startMerge</text>
            <text x="180" y="269" text-anchor="middle" class="dr-schematic__label-mono dr-schematic__label-mono--sm">cherryPick</text>
          </g>
          <g class="dr-schematic__layer" style="--d: 0.84s">
            <rect x="220" y="235" width="80" height="50" rx="2"
                  fill="var(--gs-paper)" stroke="var(--gs-cyan)" stroke-width="1.5"
                  class="dr-schematic__rect"/>
            <text x="260" y="255" text-anchor="middle" class="dr-schematic__label-mono dr-schematic__label-mono--sm">withAuthor</text>
            <text x="260" y="269" text-anchor="middle" class="dr-schematic__label-mono dr-schematic__label-mono--sm">addSubmodule</text>
          </g>

          <!-- Atom layer label -->
          <text x="180" y="298" text-anchor="middle" class="dr-schematic__label-small dr-schematic__label-small--strong">60+ COMPOSABLE ATOMS</text>

          <!-- Numbered callout balloons (right side, pointing at each layer) -->
          <g class="dr-callout" style="--d: 1.0s">
            <line x1="305" y1="65" x2="335" y2="65"
                  stroke="var(--gs-vermilion)" stroke-width="1"
                  marker-end="url(#tick)" marker-start="url(#tick)"/>
            <circle cx="345" cy="65" r="8" fill="var(--gs-paper)"
                    stroke="var(--gs-vermilion)" stroke-width="1.2"/>
            <text x="345" y="68" text-anchor="middle"
                  class="dr-schematic__callout-num">3</text>
          </g>
          <g class="dr-callout" style="--d: 1.08s">
            <line x1="325" y1="165" x2="335" y2="165"
                  stroke="var(--gs-vermilion)" stroke-width="1"
                  marker-end="url(#tick)" marker-start="url(#tick)"/>
            <circle cx="345" cy="165" r="8" fill="var(--gs-paper)"
                    stroke="var(--gs-vermilion)" stroke-width="1.2"/>
            <text x="345" y="168" text-anchor="middle"
                  class="dr-schematic__callout-num">2</text>
          </g>
          <g class="dr-callout" style="--d: 1.16s">
            <line x1="305" y1="260" x2="335" y2="260"
                  stroke="var(--gs-vermilion)" stroke-width="1"
                  marker-end="url(#tick)" marker-start="url(#tick)"/>
            <circle cx="345" cy="260" r="8" fill="var(--gs-paper)"
                    stroke="var(--gs-vermilion)" stroke-width="1.2"/>
            <text x="345" y="263" text-anchor="middle"
                  class="dr-schematic__callout-num">1</text>
          </g>

          <!-- Vertical dimension line on the left side -->
          <g class="dr-dimension" style="--d: 1.3s">
            <line x1="15" y1="50" x2="15" y2="285"
                  stroke="var(--gs-graphite)" stroke-width="0.8"
                  marker-start="url(#tick)" marker-end="url(#tick)"/>
            <text x="9" y="170" text-anchor="middle"
                  transform="rotate(-90 9 170)"
                  class="dr-schematic__dim">3 LAYERS</text>
          </g>

          <!-- Bottom legend -->
          <g class="dr-legend" style="--d: 1.45s">
            <text x="20" y="335" class="dr-schematic__legend-key">FIG. 01</text>
            <text x="68" y="335" class="dr-schematic__legend-text">Composition diagram — atoms compose into scenarios; the public</text>
            <text x="20" y="350" class="dr-schematic__legend-text">API and CLI consume the registry. Same shape every test run.</text>
          </g>
        </svg>
      </figure>
    </div>

    <!-- ═══ Specifications strip ═══ -->
    <footer class="dr-specs">
      <div class="dr-spec">
        <span class="dr-spec__num">32</span>
        <span class="dr-spec__lbl">scenarios</span>
      </div>
      <div class="dr-spec">
        <span class="dr-spec__num">60+</span>
        <span class="dr-spec__lbl">composable atoms</span>
      </div>
      <div class="dr-spec">
        <span class="dr-spec__num">2</span>
        <span class="dr-spec__lbl">test runners (jest&nbsp;·&nbsp;vitest)</span>
      </div>
      <div class="dr-spec">
        <span class="dr-spec__num">22+</span>
        <span class="dr-spec__lbl">supported node</span>
      </div>
      <div class="dr-spec">
        <span class="dr-spec__num">MIT</span>
        <span class="dr-spec__lbl">license</span>
      </div>
    </footer>
  </div>
</section>

<script>
  // Copy button on the install snippet
  const copyBtn = document.querySelector<HTMLButtonElement>('.dr-install__copy')
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const text = copyBtn.dataset.copy ?? ''
      try {
        await navigator.clipboard.writeText(text)
        copyBtn.classList.add('is-copied')
        setTimeout(() => copyBtn.classList.remove('is-copied'), 1400)
      } catch {
        /* noop */
      }
    })
  }
</script>

<style>
  /* ─── Hero shell ─── */
  .dr-hero {
    position: relative;
    padding: 1.5rem 1.5rem 4rem;
    max-width: 88rem;
    margin: 0 auto;
  }

  .dr-frame {
    position: relative;
    border: 1px solid var(--gs-rule-strong);
    background: transparent;
  }

  /* Crosshair ticks at the four corners of the drawing frame */
  .dr-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    pointer-events: none;
  }

  .dr-corner::before,
  .dr-corner::after {
    content: '';
    position: absolute;
    background: var(--gs-cyan);
  }

  .dr-corner::before { width: 18px; height: 1.5px; top: 50%; }
  .dr-corner::after  { width: 1.5px; height: 18px; left: 50%; }

  .dr-corner--tl { top: -10px; left: -10px; }
  .dr-corner--tr { top: -10px; right: -10px; }
  .dr-corner--bl { bottom: -10px; left: -10px; }
  .dr-corner--br { bottom: -10px; right: -10px; }

  /* ─── Title block (top of the drawing) ─── */
  .dr-titleblock {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 0.8fr 1fr 0.7fr;
    border-bottom: 1px solid var(--gs-rule-strong);
    background: var(--gs-cyan-low);
  }

  .dr-titleblock__cell {
    padding: 0.7rem 1rem;
    border-right: 1px solid var(--gs-rule-strong);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: 4.2rem;
    justify-content: center;
  }

  .dr-titleblock__cell:last-child {
    border-right: 0;
  }

  .dr-titleblock__cell--title {
    background: var(--gs-paper);
    padding: 0.5rem 1rem 0.6rem;
  }

  .dr-label {
    font-family: var(--gs-mono);
    font-size: 0.58rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--gs-graphite);
  }

  .dr-value {
    font-family: var(--gs-mono);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--gs-ink);
  }

  .dr-value--accent {
    color: var(--gs-vermilion);
    font-weight: 500;
  }

  .dr-title {
    font-family: var(--gs-display) !important;
    font-variation-settings: 'opsz' 96, 'wdth' 88, 'wght' 700 !important;
    font-size: clamp(1.6rem, 2.4vw, 2.1rem) !important;
    letter-spacing: -0.04em !important;
    line-height: 1 !important;
    margin: 0.15rem 0 0 0 !important;
    color: var(--gs-ink) !important;
  }

  @media (max-width: 900px) {
    .dr-titleblock {
      grid-template-columns: 2fr 1fr 1fr;
    }
    .dr-titleblock__cell--scale {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .dr-titleblock {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ─── Drawing area ─── */
  .dr-drawing {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: stretch;
    border-bottom: 1px solid var(--gs-rule-strong);
  }

  .dr-headline {
    padding: 3rem 2rem 3rem 2.5rem;
    border-right: 1px solid var(--gs-rule);
    position: relative;
    /* Grid lives on body::before — no need for another one here */
  }

  /* "01" callout in the top-left of the headline area */
  .dr-headline::before {
    content: '01';
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    width: 2.4rem;
    height: 2.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--gs-vermilion);
    border-radius: 999px;
    background: var(--gs-paper);
    color: var(--gs-vermilion);
    font-family: var(--gs-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .dr-eyebrow {
    font-family: var(--gs-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gs-cyan);
    margin: 0 0 1.5rem;
    padding-left: 4rem;          /* clear of the 01 callout */
    line-height: 1.6;
  }

  .dr-display {
    font-family: var(--gs-display);
    font-variation-settings: 'opsz' 96, 'wdth' 88, 'wght' 700;
    font-size: clamp(2.4rem, 5.5vw, 3.8rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin: 0 0 1.75rem;
    color: var(--gs-ink);
    display: flex;
    flex-direction: column;
    gap: 0.05em;
  }

  .dr-display__line {
    display: block;
  }

  .dr-display em {
    font-style: italic;
    font-variation-settings: 'opsz' 96, 'wdth' 95, 'wght' 600;
    color: var(--gs-vermilion);
  }

  .dr-lede {
    font-family: var(--gs-body);
    font-variation-settings: 'opsz' 24;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    max-width: 36rem;
    margin: 0 0 2rem;
  }

  /* ─── Actions — high contrast, no inversion legibility issues ─── */
  .dr-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
    margin-bottom: 1.75rem;
  }

  .dr-action {
    font-family: var(--gs-mono);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.85rem 1.4rem;
    border-radius: 2px;
    text-decoration: none;
    border: 1.5px solid var(--gs-cyan);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, color 0.18s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  /* Primary: cyan FILL with paper TEXT — explicit colors (with
     !important) so no global a-tag rule from .sl-markdown-content
     can leak in and break the contrast. */
  .dr-action--primary {
    background: var(--gs-cyan);
    color: var(--gs-paper) !important;
    border-color: var(--gs-cyan);
    font-weight: 600;
    border-bottom: 1.5px solid var(--gs-cyan) !important;  /* override global a underline */
  }

  /* Critical: in light mode the paper is cream and the cyan is deep
     blue; the text needs to read as light cream on deep blue. In
     dark mode it's the reverse — bright cyan with dark navy text.
     Both directions use --gs-paper (cream/navy respectively) so
     contrast is consistent. */

  .dr-action--primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 0 var(--gs-cyan-dim);
    background: var(--gs-cyan) !important;          /* keep solid on hover */
    color: var(--gs-paper) !important;
  }

  .dr-action--ghost {
    color: var(--gs-cyan) !important;
    background: transparent !important;
    border-color: var(--gs-rule-strong);
    border-bottom: 1.5px solid var(--gs-rule-strong) !important;
  }

  .dr-action--ghost:hover {
    color: var(--gs-cyan) !important;
    border-color: var(--gs-cyan);
    border-bottom-color: var(--gs-cyan) !important;
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 0 var(--gs-rule-strong);
    background: transparent !important;
  }

  /* ─── Install snippet ─── */
  .dr-install {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--gs-rule-strong);
    border-radius: 2px;
    background: var(--gs-paper);
    font-family: var(--gs-mono);
    font-size: 0.83rem;
    max-width: 100%;
  }

  .dr-install__prompt {
    color: var(--gs-cyan);
    font-weight: 600;
    user-select: none;
  }

  .dr-install__cmd {
    color: var(--gs-ink);
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    font-size: inherit;
    font-family: inherit;
    overflow-x: auto;
    white-space: nowrap;
  }

  .dr-install__copy {
    appearance: none;
    background: transparent;
    border: none;
    color: var(--gs-graphite);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease, background 0.15s ease;
