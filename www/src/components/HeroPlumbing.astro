---
/**
 * The new landing-page hero — "The Plumbing Manual" opening spread.
 *
 * Editorial-technical lockup: a Fraunces display headline anchored
 * left, a CSS-rendered git-log graph anchored right. Subtle pinstripe
 * column rules in the background pull from the manpage / periodical
 * vocabulary.
 *
 * Pure HTML + CSS — no JS, no client islands. The "live commit graph"
 * is staggered animation on plain divs.
 */
---

<section class="ph-hero" aria-label="Introduction">
  <div class="ph-hero__inner">
    <!-- Meta ribbon — like the running header on a manpage -->
    <div class="ph-meta">
      <span class="ph-meta__page">man.gs(7)</span>
      <span class="ph-meta__sep">·</span>
      <span class="ph-meta__name">git-scenarios</span>
      <span class="ph-meta__sep">·</span>
      <span class="ph-meta__edition">first edition · v0.6.0</span>
    </div>

    <div class="ph-grid">
      <!-- Left column: the editorial lockup -->
      <div class="ph-col ph-col--text">
        <p class="ph-eyebrow">A composable kit for git-state fixtures.</p>

        <h1 class="ph-headline">
          Real git repositories,<br/>
          <em>any state,</em><br/>
          one line of code.
        </h1>

        <p class="ph-lede">
          A typed atom library and CLI for spinning up deterministic
          git fixtures &mdash; merge conflicts, submodules, multiple
          remotes, in-progress operations, monorepos, orphan branches.
          For tests, demos, and tool development.
        </p>

        <div class="ph-actions">
          <a class="ph-action ph-action--primary" href="/docs/quick-start">
            <span class="ph-action__cmd">$&nbsp;</span>get&nbsp;started
            <span class="ph-action__arrow">→</span>
          </a>
          <a class="ph-action ph-action--ghost" href="https://github.com/gfargo/git-scenarios">
            view source ↗
          </a>
        </div>

        <!-- The npm install snippet — small, monospace, terminal-feel -->
        <div class="ph-install">
          <span class="ph-install__prompt">$</span>
          <code class="ph-install__cmd">npm i -D @gfargo/git-scenarios simple-git</code>
          <button class="ph-install__copy" data-copy="npm install --save-dev @gfargo/git-scenarios simple-git" aria-label="Copy install command">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="4" y="4" width="9" height="9" rx="1.5"/>
              <path d="M3 11V3.5A1.5 1.5 0 0 1 4.5 2H11"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Right column: the git log graph specimen -->
      <div class="ph-col ph-col--graph">
        <div class="ph-graph" role="img" aria-label="Animated git log graph showing commits, branches, and a merge">
          <!-- Header -->
          <div class="ph-graph__header">
            <span class="ph-graph__path">~/repo</span>
            <span class="ph-graph__cmd">git log --graph --oneline</span>
          </div>

          <!-- Commit rows -->
          <ol class="ph-graph__rows">
            <li class="ph-graph__row" style="--d:0.0s">
              <span class="ph-graph__glyph" aria-hidden="true">*</span>
              <span class="ph-graph__sha">a1b2c3d</span>
              <span class="ph-graph__chips">
                <em class="ph-chip ph-chip--head">HEAD</em>
                <em class="ph-chip ph-chip--branch">main</em>
              </span>
              <span class="ph-graph__msg">feat: scaffold widget v2</span>
            </li>
            <li class="ph-graph__row" style="--d:0.08s">
              <span class="ph-graph__glyph" aria-hidden="true">*</span>
              <span class="ph-graph__sha">9f8e7d6</span>
              <span class="ph-graph__msg">test: cover edge cases</span>
            </li>
            <li class="ph-graph__row ph-graph__row--merge" style="--d:0.16s">
              <span class="ph-graph__glyph" aria-hidden="true">*<span class="ph-graph__merge-glyph">⤬</span></span>
              <span class="ph-graph__sha">5e4d3c2</span>
              <span class="ph-graph__chips">
                <em class="ph-chip ph-chip--branch">feat/widget-v2</em>
              </span>
              <span class="ph-graph__msg">Merge branch 'feat/widget-v2'</span>
            </li>
            <li class="ph-graph__row ph-graph__row--branch" style="--d:0.24s">
              <span class="ph-graph__glyph" aria-hidden="true">|<i>\</i></span>
              <span class="ph-graph__sha">b1a2c3d</span>
              <span class="ph-graph__msg">refactor: split utils module</span>
            </li>
            <li class="ph-graph__row ph-graph__row--branch" style="--d:0.32s">
              <span class="ph-graph__glyph" aria-hidden="true">|&nbsp;*</span>
              <span class="ph-graph__sha">c4d5e6f</span>
              <span class="ph-graph__msg">feat: expose new public API</span>
            </li>
            <li class="ph-graph__row" style="--d:0.40s">
              <span class="ph-graph__glyph" aria-hidden="true">*</span>
              <span class="ph-graph__sha">7g8h9i0</span>
              <span class="ph-graph__chips">
                <em class="ph-chip ph-chip--remote">origin/main</em>
              </span>
              <span class="ph-graph__msg">chore: bump dependencies</span>
            </li>
            <li class="ph-graph__row" style="--d:0.48s">
              <span class="ph-graph__glyph" aria-hidden="true">*</span>
              <span class="ph-graph__sha">f0e9d8c</span>
              <span class="ph-graph__chips">
                <em class="ph-chip ph-chip--tag">v0.5.0</em>
              </span>
              <span class="ph-graph__msg">release: v0.5.0</span>
            </li>
            <li class="ph-graph__row" style="--d:0.56s">
              <span class="ph-graph__glyph" aria-hidden="true">*</span>
              <span class="ph-graph__sha">3a4b5c6</span>
              <span class="ph-graph__msg">docs: update changelog</span>
            </li>
            <li class="ph-graph__row ph-graph__row--ellipsis" style="--d:0.64s" aria-hidden="true">
              <span class="ph-graph__glyph">|</span>
              <span class="ph-graph__msg">...</span>
            </li>
          </ol>

          <!-- Caption — typeset like a figure label in a journal -->
          <div class="ph-graph__caption">
            <span class="ph-graph__fig">FIG. 01</span>
            <span class="ph-graph__caption-text">An example git log produced by <code>spinUpScenario('rich-history-graph')</code> &mdash; same shape every run.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats strip — newspaper-style by-the-numbers -->
    <dl class="ph-stats">
      <div class="ph-stat">
        <dt>scenarios</dt>
        <dd>32</dd>
      </div>
      <div class="ph-stat">
        <dt>composable atoms</dt>
        <dd>60+</dd>
      </div>
      <div class="ph-stat">
        <dt>test runners</dt>
        <dd>jest · vitest</dd>
      </div>
      <div class="ph-stat">
        <dt>supported node</dt>
        <dd>22 · 24 · 26+</dd>
      </div>
      <div class="ph-stat">
        <dt>license</dt>
        <dd>mit</dd>
      </div>
    </dl>
  </div>
</section>

<script>
  // Copy button on the install snippet
  const copyBtn = document.querySelector<HTMLButtonElement>('.ph-install__copy')
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const text = copyBtn.dataset.copy ?? ''
      try {
        await navigator.clipboard.writeText(text)
        copyBtn.classList.add('is-copied')
        setTimeout(() => copyBtn.classList.remove('is-copied'), 1400)
      } catch {
        /* noop */
      }
    })
  }
</script>

<style>
  .ph-hero {
    position: relative;
    padding: 4.5rem 0 3rem;
    overflow: hidden;
  }

  /* Pinstripe column rules running the full height — like the gutter
     marks between columns in a printed periodical. */
  .ph-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--gs-rule) 1px, transparent 1px);
    background-size: 8.333% 100%;
    background-position: 0 0;
    opacity: 0.5;
    pointer-events: none;
  }

  /* Soft emerald glow on the right edge — the only chromatic accent */
  .ph-hero::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -15%;
    width: 720px;
    height: 720px;
    background: radial-gradient(circle, var(--gs-emerald-mid) 0%, transparent 65%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .ph-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ─── Meta ribbon ─── */
  .ph-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--gs-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--sl-color-gray-4);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--gs-rule);
    margin-bottom: 3.5rem;
  }

  .ph-meta__sep {
    color: var(--gs-rule-strong);
  }

  .ph-meta__name {
    color: var(--gs-emerald);
    font-weight: 500;
  }

  /* ─── Two-column lockup ─── */
  .ph-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 64rem) {
    .ph-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  /* ─── Left column: editorial copy ─── */
  .ph-col--text {
    max-width: 38rem;
  }

  .ph-eyebrow {
    font-family: var(--gs-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gs-emerald);
    margin: 0 0 1.5rem;
    padding-left: 0.85rem;
    border-left: 2px solid var(--gs-emerald);
    line-height: 1.6;
  }

  .ph-headline {
    font-family: var(--gs-display);
    font-variation-settings: 'opsz' 144, 'wght' 540, 'SOFT' 50;
    font-size: clamp(2.6rem, 6.4vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0 0 2rem;
    color: var(--gs-ink);
    font-feature-settings: 'ss01';
  }

  .ph-headline em {
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'wght' 460, 'SOFT' 100, 'WONK' 1;
    color: var(--gs-emerald);
    letter-spacing: -0.05em;
  }

  .ph-lede {
    font-family: var(--gs-body);
    font-variation-settings: 'opsz' 18, 'SOFT' 50, 'WONK' 0;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    max-width: 36rem;
    margin: 0 0 2rem;
  }

  /* ─── Actions ─── */
  .ph-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
    margin-bottom: 2.25rem;
  }

  .ph-action {
    font-family: var(--gs-mono);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.85rem 1.4rem;
    border-radius: 2px;
    text-decoration: none;
    border: 1px solid var(--gs-rule-strong);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    line-height: 1;
  }

  .ph-action--primary {
    background: var(--gs-emerald);
    color: var(--gs-paper);
    border-color: var(--gs-emerald);
    font-weight: 600;
  }

  .ph-action--primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 0 var(--gs-emerald-dim);
  }

  .ph-action__cmd {
    opacity: 0.85;
  }

  .ph-action__arrow {
    transition: transform 0.18s ease;
  }

  .ph-action--primary:hover .ph-action__arrow {
    transform: translateX(2px);
  }

  .ph-action--ghost {
    color: var(--sl-color-gray-2);
    background: transparent;
  }

  .ph-action--ghost:hover {
    color: var(--gs-emerald);
    border-color: var(--gs-emerald);
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 0 var(--gs-rule-strong);
  }

  /* ─── Install snippet ─── */
  .ph-install {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--gs-rule);
    border-radius: 4px;
    background: var(--gs-surface);
    font-family: var(--gs-mono);
    font-size: 0.83rem;
    max-width: 100%;
  }

  .ph-install__prompt {
    color: var(--gs-emerald);
    font-weight: 600;
    user-select: none;
  }

  .ph-install__cmd {
    color: var(--sl-color-gray-1);
    background: transparent;
    border: none;
    padding: 0;
    font-size: inherit;
    font-family: inherit;
    overflow-x: auto;
    white-space: nowrap;
  }

  .ph-install__copy {
    appearance: none;
    background: transparent;
    border: none;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .ph-install__copy:hover {
    color: var(--gs-emerald);
    background: var(--gs-emerald-low);
  }

  .ph-install__copy.is-copied {
    color: var(--gs-emerald);
  }

  .ph-install__copy.is-copied::after {
    content: 'copied';
    margin-left: 0.4rem;
    font-family: var(--gs-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ─── Right column: graph specimen ─── */
  .ph-col--graph {
    position: relative;
  }

  .ph-graph {
    border: 1px solid var(--gs-rule);
    border-radius: 6px;
    background: var(--gs-surface);
    padding: 1rem 1.25rem 1.1rem;
    font-family: var(--gs-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--sl-color-gray-2);
    box-shadow:
      0 0 0 1px var(--gs-rule) inset,
      0 1px 0 0 rgba(0, 0, 0, 0.04);
    position: relative;
  }

  /* Figure label in the corner — like a TOC entry */
  .ph-graph::before {
    content: '/* live specimen */';
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-family: var(--gs-mono);
    font-size: 0.62rem;
    color: var(--sl-color-gray-4);
    letter-spacing: 0.08em;
    font-style: italic;
  }

  .ph-graph__header {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    padding-bottom: 0.6rem;
    margin-bottom: 0.7rem;
    border-bottom: 1px dashed var(--gs-rule);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  .ph-graph__path {
    color: var(--gs-cyan);
  }

  .ph-graph__path::before {
    content: '~/';
    color: var(--sl-color-gray-4);
    margin-right: 0;
  }

  .ph-graph__cmd {
    color: var(--sl-color-gray-2);
  }

  .ph-graph__cmd::before {
    content: '$ ';
    color: var(--gs-emerald);
    font-weight: 600;
    margin-right: 0.2ch;
  }

  /* Commit rows */
  .ph-graph__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .ph-graph__row {
    display: grid;
    grid-template-columns: 2.5ch 8ch minmax(0, auto) 1fr;
    gap: 0.75ch;
    align-items: baseline;
    padding-block: 0.05rem;
    /* Remove the global ::before bullet from .sl-markdown-content ul */
  }

  .ph-graph__row::before {
    content: none !important;
  }

  /* Animation: each row sweeps in from left like a typed line */
  .ph-graph__row {
    animation: graph-line-in 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes graph-line-in {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Glyph (the * | / characters) */
  .ph-graph__glyph {
    color: var(--gs-emerald);
    font-weight: 600;
    white-space: pre;
    text-align: center;
  }

  .ph-graph__row--branch .ph-graph__glyph {
    color: var(--gs-emerald-dim);
  }

  .ph-graph__row--merge .ph-graph__glyph {
    color: var(--gs-amber);
  }

  .ph-graph__row--ellipsis .ph-graph__glyph {
    color: var(--sl-color-gray-4);
  }

  .ph-graph__merge-glyph {
    color: var(--gs-amber);
    font-style: normal;
  }

  /* Short SHA */
  .ph-graph__sha {
    color: var(--gs-amber);
    font-weight: 500;
    letter-spacing: 0;
  }

  /* Chips (HEAD, branch, tag, remote) */
  .ph-graph__chips {
    display: inline-flex;
    gap: 0.25rem;
    align-items: baseline;
  }

  .ph-chip {
    font-family: var(--gs-mono);
    font-style: normal;
    font-size: 0.66rem;
    font-weight: 500;
    text-transform: lowercase;
    padding: 0 0.4rem;
    border-radius: 2px;
    letter-spacing: 0;
    border: 1px solid currentColor;
    line-height: 1.5;
    white-space: nowrap;
  }

  .ph-chip--head {
    color: var(--gs-cyan);
    background: rgba(103, 232, 249, 0.08);
  }

  .ph-chip--branch {
    color: var(--gs-emerald);
    background: var(--gs-emerald-low);
  }

  .ph-chip--remote {
    color: var(--gs-red);
    background: var(--gs-red-low);
  }

  .ph-chip--tag {
    color: var(--gs-amber);
    background: rgba(251, 191, 36, 0.08);
  }

  :root[data-theme='light'] .ph-chip--head {
    background: rgba(14, 116, 144, 0.06);
  }

  :root[data-theme='light'] .ph-chip--remote {
    background: rgba(185, 28, 28, 0.05);
  }

  :root[data-theme='light'] .ph-chip--tag {
    background: rgba(180, 83, 9, 0.06);
  }

  /* Commit message */
  .ph-graph__msg {
    color: var(--sl-color-gray-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ph-graph__row--ellipsis .ph-graph__msg {
    color: var(--sl-color-gray-4);
    letter-spacing: 0.4em;
  }

  /* Caption under the graph */
  .ph-graph__caption {
    margin-top: 0.85rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--gs-rule);
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    font-family: var(--gs-body);
    font-variation-settings: 'opsz' 12, 'SOFT' 50, 'WONK' 1;
    font-style: italic;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .ph-graph__fig {
    font-family: var(--gs-mono);
    font-style: normal;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gs-emerald);
    flex-shrink: 0;
    padding-top: 0.05rem;
  }

  .ph-graph__caption-text code {
    font-size: 0.72rem;
    color: var(--gs-emerald);
    background: var(--gs-emerald-low);
    padding: 0.05em 0.3em;
    border-radius: 2px;
    font-family: var(--gs-mono);
    font-style: normal;
    border: 1px solid var(--gs-emerald-mid);
  }

  /* ─── Stats strip ─── */
  .ph-stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    margin: 5rem 0 0;
    padding: 1.6rem 0 0;
    border-top: 1px solid var(--gs-rule);
    list-style: none;
  }

  .ph-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .ph-stat dt {
    font-family: var(--gs-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--sl-color-gray-4);
    margin: 0;
  }

  .ph-stat dd {
    font-family: var(--gs-display);
    font-variation-settings: 'opsz' 96, 'wght' 540, 'SOFT' 50;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--gs-ink);
  }

  @media (max-width: 50rem) {
    .ph-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 1rem;
    }
  }

  /* ─── Entrance animation ─── */
  .ph-meta,
  .ph-eyebrow,
  .ph-headline,
  .ph-lede,
  .ph-actions,
  .ph-install,
  .ph-graph,
  .ph-stats {
    animation: ph-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .ph-meta     { animation-delay: 0s; }
  .ph-eyebrow  { animation-delay: 0.1s; }
  .ph-headline { animation-delay: 0.18s; }
  .ph-lede     { animation-delay: 0.32s; }
  .ph-actions  { animation-delay: 0.42s; }
  .ph-install  { animation-delay: 0.5s; }
  .ph-graph    { animation-delay: 0.36s; }
  .ph-stats    { animation-delay: 0.7s; }

  @keyframes ph-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ph-graph__row,
    .ph-meta,
    .ph-eyebrow,
    .ph-headline,
    .ph-lede,
    .ph-actions,
    .ph-install,
    .ph-graph,
    .ph-stats {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
