---
/**
 * Custom Header override that adds navigation links to the Starlight header.
 * Extends the default Header with a nav bar containing key doc links.
 */
import Default from '@astrojs/starlight/components/Header.astro'
---

<Default {...Astro.props}><slot /></Default>

<nav class="header-nav" aria-label="Main navigation">
  <a href="/docs/introduction">Docs</a>
  <a href="/docs/quick-start">Quick Start</a>
  <a href="/docs/scenarios/overview">Scenarios</a>
  <a href="/docs/atoms/overview">Atoms</a>
  <a href="/docs/guides/cli">CLI</a>
</nav>

<style>
  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
    background: var(--sl-color-bg-nav);
    font-family: var(--sl-font-system-mono);
    font-size: 0.78rem;
    overflow-x: auto;
  }

  .header-nav a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    padding: 0.5rem 0.65rem;
    border-radius: 4px;
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .header-nav a:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  /* Hide on mobile — sidebar handles navigation there */
  @media (max-width: 50rem) {
    .header-nav {
      display: none;
    }
  }
</style>
