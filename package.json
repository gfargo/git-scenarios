{
  "name": "@gfargo/git-scenarios",
  "version": "0.6.0",
  "description": "Composable atoms for spinning up real git repos in any state — merge conflicts, out-of-date submodules, multiple remotes, in-progress operations, multi-contributor history, and more. For tests, demos, and tool development.",
  "license": "MIT",
  "author": {
    "name": "Griffen Fargo",
    "url": "https://github.com/gfargo"
  },
  "homepage": "https://github.com/gfargo/git-scenarios#readme",
  "bugs": {
    "url": "https://github.com/gfargo/git-scenarios/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gfargo/git-scenarios.git"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./scenarios": {
      "types": "./dist/scenarios/index.d.ts",
      "import": "./dist/scenarios/index.js",
      "require": "./dist/scenarios/index.cjs"
    },
    "./tempGitRepo": {
      "types": "./dist/tempGitRepo.d.ts",
      "import": "./dist/tempGitRepo.js",
      "require": "./dist/tempGitRepo.cjs"
    },
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms/index.js",
      "require": "./dist/atoms/index.cjs"
    },
    "./jest": {
      "types": "./dist/jest.d.ts",
      "import": "./dist/jest.js",
      "require": "./dist/jest.cjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js",
      "require": "./dist/vitest.cjs"
    }
  },
  "bin": {
    "git-scenarios": "./dist/bin/cli.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc -p .",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run lint"
  },
  "keywords": [
    "git",
    "test",
    "fixture",
    "scenario",
    "simple-git",
    "temp-repo",
    "submodule",
    "merge-conflict",
    "bisect",
    "stash",
    "worktree",
    "testing",
    "deterministic"
  ],
  "peerDependencies": {
    "simple-git": "^3.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "simple-git": "^3.27.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
