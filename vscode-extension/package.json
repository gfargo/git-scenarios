{
  "name": "git-scenarios-vscode",
  "displayName": "git-scenarios",
  "description": "Spin up real git scenario repos from the command palette",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitScenarios.create",
        "title": "git-scenarios: Create Scenario…"
      },
      {
        "command": "gitScenarios.cleanup",
        "title": "git-scenarios: Clean Up Scenario Directories"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "jest --config jest.config.cjs"
  },
  "dependencies": {
    "@gfargo/git-scenarios": "file:..",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
